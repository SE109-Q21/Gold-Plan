# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gpls_dev

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-at-least-32-chars
JWT_EXPIRES_IN=24h

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=4000
APP_URL=http://localhost:3000

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# Leave blank to disable email sending (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gpls.vn

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ─── AI (OpenAI) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Price data APIs ─────────────────────────────────────────────────────────
GOLD_API_KEY=
EXCHANGE_RATE_API_KEY=

# ─── Misc ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
WEB_URL=http://localhost:3000
